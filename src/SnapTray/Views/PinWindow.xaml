<Window x:Class="SnapTray.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 置顶截图" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Width="400" Height="300"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderBrush="#6695FF" BorderThickness="1" Background="#101827">
        <Grid>
            <Image x:Name="Screenshot" Stretch="Uniform" SnapsToDevicePixels="True"
                   MouseLeftButtonDown="OnImageMouseDown" MouseWheel="OnImageMouseWheel"
                   ToolTip="拖动移动 · 滚轮缩放 · 双击还原 · 右键操作 · Esc 关闭">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制截图" Click="OnCopyClick" />
                        <MenuItem Header="另存为…" Click="OnSaveClick" />
                        <Separator />
                        <MenuItem Header="关闭贴图" Click="OnCloseClick" />
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
            <Button Content="×" AutomationProperties.Name="关闭置顶截图"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="30" Height="30" Padding="0" Margin="5"
                    Background="#DD182235" Foreground="White" BorderThickness="0"
                    FontSize="20" ToolTip="关闭 (Esc)" Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
