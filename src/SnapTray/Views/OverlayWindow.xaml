<Window x:Class="SnapTray.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SnapTray.Views"
        Title="轻截 · 选择截图区域" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Black"
        WindowStartupLocation="Manual" Width="800" Height="600" Cursor="Cross"
        PreviewMouseLeftButtonDown="OnSelectionDown" MouseMove="OnSelectionMove"
        MouseLeftButtonUp="OnSelectionUp" LostMouseCapture="OnLostMouseCapture"
        PreviewMouseRightButtonDown="OnRightButtonDown" MouseLeave="OnMouseLeave"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#26344A" />
            <Setter Property="BorderBrush" Value="#3E5170" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid x:Name="Surface" ClipToBounds="True" SizeChanged="OnSurfaceSizeChanged">
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Canvas x:Name="DrawingLayer" IsHitTestVisible="False">
            <Path x:Name="Shade" Fill="#88070D17" />
            <Rectangle x:Name="WindowHintBorder" Stroke="#34D399" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Fill="#1834D399" Visibility="Collapsed" />
            <Border x:Name="WindowHintBadge" Background="#F20F766E" CornerRadius="4" Padding="9,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="WindowHintText" Foreground="White" FontSize="12" />
            </Border>
            <Rectangle x:Name="SelectionBorder" Stroke="#38BDF8" StrokeThickness="1.5"
                       Visibility="Collapsed" />
            <Border x:Name="SizeBadge" Background="#E6172033" CornerRadius="4" Padding="9,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <Canvas x:Name="AnnotationLayerHost" IsHitTestVisible="False" ClipToBounds="True">
            <views:AnnotationCanvas x:Name="AnnotationLayer" />
        </Canvas>
        <Canvas x:Name="ControlsLayer">
            <Border x:Name="HintBar" Background="#F2172033" CornerRadius="10" Padding="10"
                    Cursor="Arrow">
                <StackPanel>
                    <TextBlock Text="拖动选择区域 · 单击截取窗口 · Esc 取消" Foreground="White" Margin="5,0,5,7" />
                    <WrapPanel>
                        <Button Content="当前屏幕 (F)" Style="{StaticResource OverlayButton}" Click="OnCurrentScreen" />
                        <Button Content="全部屏幕 (Ctrl+F)" Style="{StaticResource OverlayButton}" Click="OnAllScreens" />
                        <Button Content="× 取消" Style="{StaticResource OverlayButton}" Click="OnCancel" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ActionBar" Background="#F2172033" CornerRadius="10" Padding="6"
                    Cursor="Arrow" Visibility="Collapsed">
                <StackPanel>
                    <WrapPanel x:Name="ToolRow">
                        <Button x:Name="RectangleTool" Content="▭ 矩形" ToolTip="矩形框 (R)"
                                Style="{StaticResource OverlayButton}" Click="OnRectangleTool" />
                        <Button x:Name="EllipseTool" Content="◯ 椭圆" ToolTip="椭圆/圈 (E)"
                                Style="{StaticResource OverlayButton}" Click="OnEllipseTool" />
                        <Button x:Name="ArrowTool" Content="↗ 箭头" ToolTip="箭头 (A)"
                                Style="{StaticResource OverlayButton}" Click="OnArrowTool" />
                        <Button x:Name="PenTool" Content="✎ 画笔" ToolTip="自由画笔 (B)"
                                Style="{StaticResource OverlayButton}" Click="OnPenTool" />
                        <Button x:Name="MosaicTool" Content="▦ 马赛克" ToolTip="马赛克 (M)"
                                Style="{StaticResource OverlayButton}" Click="OnMosaicTool" />
                        <Button x:Name="TextTool" Content="T 文字" ToolTip="添加文字 (T)"
                                Style="{StaticResource OverlayButton}" Click="OnTextTool" />
                        <Rectangle Width="1" Height="18" Fill="#475569" Margin="8,0" />
                        <Border x:Name="ColorRed" Width="18" Height="18" CornerRadius="9" Background="#F5222D"
                                Margin="4,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                ToolTip="红色" MouseLeftButtonDown="OnColorRed" />
                        <Border x:Name="ColorOrange" Width="18" Height="18" CornerRadius="9" Background="#FA8C16"
                                Margin="4,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                ToolTip="橙色" MouseLeftButtonDown="OnColorOrange" />
                        <Border x:Name="ColorBlue" Width="18" Height="18" CornerRadius="9" Background="#1677FF"
                                Margin="4,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                ToolTip="蓝色" MouseLeftButtonDown="OnColorBlue" />
                        <Border x:Name="ColorGreen" Width="18" Height="18" CornerRadius="9" Background="#22C55E"
                                Margin="4,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                ToolTip="绿色" MouseLeftButtonDown="OnColorGreen" />
                        <Rectangle x:Name="SizeSeparator" Width="1" Height="18" Fill="#475569" Margin="8,0"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="BrushSizePanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="粗细" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Border x:Name="SizeSmall" Width="22" Height="22" CornerRadius="11" Background="#26344A"
                                    Margin="3,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                    ToolTip="细" MouseLeftButtonDown="OnSizeSmall">
                                <Ellipse Width="6" Height="6" Fill="#F8FAFC"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SizeMedium" Width="22" Height="22" CornerRadius="11" Background="#26344A"
                                    Margin="3,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                    ToolTip="中" MouseLeftButtonDown="OnSizeMedium">
                                <Ellipse Width="10" Height="10" Fill="#F8FAFC"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="SizeLarge" Width="22" Height="22" CornerRadius="11" Background="#26344A"
                                    Margin="3,0" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                    ToolTip="粗" MouseLeftButtonDown="OnSizeLarge">
                                <Ellipse Width="14" Height="14" Fill="#F8FAFC"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel x:Name="ActionRow" Margin="0,4,0,0">
                        <Button x:Name="OcrButton" Content="取字" ToolTip="识别选区里的文字，离线 OCR（Ctrl+E）"
                                Style="{StaticResource OverlayButton}" Click="OnOcrClick" />
                        <Button x:Name="TranslateButton" Content="翻译" ToolTip="识别并翻译，需要联网（Ctrl+T）"
                                Style="{StaticResource OverlayButton}" Click="OnTranslateClick" />
                        <Button x:Name="ScrollButton" Content="滚动截图" ToolTip="逐屏向下滚动并拼接长图，按 Esc 结束（Ctrl+L）"
                                Style="{StaticResource OverlayButton}" Click="OnScrollClick" />
                        <Button x:Name="UndoButton" Content="↶ 撤销" ToolTip="撤销上一步标注 (Ctrl+Z)"
                                Style="{StaticResource OverlayButton}" Click="OnUndoClick" />
                        <Rectangle Width="1" Height="18" Fill="#475569" Margin="8,0" />
                        <Button Content="保存" ToolTip="保存为 PNG（Ctrl+S）" Style="{StaticResource OverlayButton}" Click="OnSave" />
                        <Button Content="置顶" ToolTip="将截图固定在桌面上（Ctrl+P）" Style="{StaticResource OverlayButton}" Click="OnPin" />
                        <Button Content="× 取消" ToolTip="取消本次截图 (Esc)" Style="{StaticResource OverlayButton}" Click="OnCancel" />
                        <Button Content="✓ 完成" ToolTip="复制到剪贴板并结束 (Enter)" Background="#2563EB"
                                Style="{StaticResource OverlayButton}" Click="OnCopy" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
