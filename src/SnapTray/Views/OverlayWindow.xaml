<Window x:Class="SnapTray.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 选择截图区域" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Black"
        WindowStartupLocation="Manual" Width="800" Height="600" Cursor="Cross"
        PreviewMouseLeftButtonDown="OnSelectionDown" MouseMove="OnSelectionMove"
        MouseLeftButtonUp="OnSelectionUp" LostMouseCapture="OnLostMouseCapture"
        PreviewMouseRightButtonDown="OnRightButtonDown" MouseLeave="OnMouseLeave"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#263346" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid x:Name="Surface" ClipToBounds="True" SizeChanged="OnSurfaceSizeChanged">
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Canvas x:Name="DrawingLayer" IsHitTestVisible="False">
            <Path x:Name="Shade" Fill="#88070D17" />
            <Rectangle x:Name="WindowHintBorder" Stroke="#34D399" StrokeThickness="1.5"
                       StrokeDashArray="4 3" Fill="#1834D399" Visibility="Collapsed" />
            <Border x:Name="WindowHintBadge" Background="#F20F766E" CornerRadius="4" Padding="9,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="WindowHintText" Foreground="White" FontSize="12" />
            </Border>
            <Rectangle x:Name="SelectionBorder" Stroke="#38BDF8" StrokeThickness="1.5"
                       Visibility="Collapsed" />
            <Border x:Name="SizeBadge" Background="#E6172033" CornerRadius="4" Padding="9,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <Canvas x:Name="ControlsLayer">
            <Border x:Name="HintBar" Background="#F2172033" CornerRadius="10" Padding="10"
                    Cursor="Arrow">
                <StackPanel>
                    <TextBlock Text="拖动选择区域 · 单击截取窗口 · Esc 取消" Foreground="White" Margin="5,0,5,7" />
                    <WrapPanel>
                        <Button Content="当前屏幕 (F)" Style="{StaticResource OverlayButton}" Click="OnCurrentScreen" />
                        <Button Content="全部屏幕 (Ctrl+F)" Style="{StaticResource OverlayButton}" Click="OnAllScreens" />
                        <Button Content="× 取消" Style="{StaticResource OverlayButton}" Click="OnCancel" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ActionBar" Background="#F2172033" CornerRadius="10" Padding="6"
                    Cursor="Arrow" Visibility="Collapsed">
                <WrapPanel>
                    <Button Content="✓ 复制" ToolTip="复制到剪贴板 (Enter)" Background="#2563EB"
                            Style="{StaticResource OverlayButton}" Click="OnCopy" />
                    <Button Content="保存" ToolTip="保存为 PNG" Style="{StaticResource OverlayButton}" Click="OnSave" />
                    <Button Content="置顶" ToolTip="将截图固定在桌面上" Style="{StaticResource OverlayButton}" Click="OnPin" />
                    <Button Content="× 取消" ToolTip="取消本次截图 (Esc)" Style="{StaticResource OverlayButton}" Click="OnCancel" />
                </WrapPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
