<Window x:Class="SnapTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 设置" Width="620" Height="700" MinWidth="540" MinHeight="480"
        Icon="pack://application:,,,/Assets/SnapTray.ico"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E9F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="轻截" FontSize="26" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="随手截图，留在眼前。" Style="{StaticResource Hint}" Margin="0,5,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8EEF7"
                    CornerRadius="10" Padding="10,4" ToolTip="构建自仓库的当前版本">
                <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="12" Foreground="#33507A"
                           AutomationProperties.Name="当前版本号" />
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Text="启动后驻留系统托盘，双击托盘图标即可截图。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="截图快捷键" Style="{StaticResource SectionTitle}" />
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox Content="Alt" IsChecked="{Binding UseAlt}" Margin="0,7,18,7" />
                            <CheckBox Content="Ctrl" IsChecked="{Binding UseControl}" Margin="0,7,18,7" />
                            <CheckBox Content="Shift" IsChecked="{Binding UseShift}" Margin="0,7,18,7" />
                            <TextBlock Text="+" Margin="0,6,12,0" />
                            <ComboBox x:Name="MainKeyBox" Width="155" Height="32" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding MainKeys}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedKey}" AutomationProperties.Name="快捷键主键" />
                        </WrapPanel>
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="HotkeyRecorder" IsReadOnly="True" Text="{Binding ShortcutLabel, Mode=OneWay}"
                                     Padding="10,8" BorderBrush="#CBD5E1" VerticalContentAlignment="Center"
                                     PreviewKeyDown="RecordHotkey_PreviewKeyDown"
                                     ToolTip="点击后按下主键或完整组合键，按 Tab 离开录入框"
                                     AutomationProperties.Name="快捷键录入框" />
                            <Button Grid.Column="1" Content="恢复默认" Margin="8,0,0,0" Click="ResetHotkey_Click" />
                        </Grid>
                        <TextBlock Text="可在上方选择，也可点击录入框直接按键。至少勾选一个修饰键；应用后立即生效。" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="默认保存目录" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1" AutomationProperties.Name="默认保存目录" />
                            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseDirectory_Click" />
                        </Grid>
                        <TextBlock Text="保存对话框会从此目录开始；也可在截图操作栏直接保存到默认目录。" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="关闭" Click="Close_Click" />
                <Button Content="应用设置" Style="{StaticResource AccentButton}" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
