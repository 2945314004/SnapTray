<Window x:Class="SnapTray.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 截图预览" Width="800" Height="570" MinWidth="550" MinHeight="320"
        Icon="pack://application:,,,/Assets/SnapTray.ico"
        WindowStartupLocation="CenterScreen" Background="#F6F8FC" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="截图已保留" FontSize="21" FontWeight="SemiBold" Foreground="#15213A" />
            <TextBlock x:Name="Details" Margin="0,6,0,0" Foreground="#62718A" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#E5EAF3" CornerRadius="6" Padding="8">
            <Image x:Name="Screenshot" Stretch="Uniform" SnapsToDevicePixels="True" />
        </Border>
        <WrapPanel x:Name="Actions" Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="✓ 复制" Style="{StaticResource AccentButton}" Click="OnCopy" />
            <Button Content="保存…" Click="OnSave" />
            <Button Content="保存到默认目录" Click="OnQuickSave" />
            <Button Content="置顶" Click="OnPin" />
            <Button Content="× 取消" Click="OnCancel" />
        </WrapPanel>
    </Grid>
</Window>
